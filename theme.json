{
  "$schema":"https:\/\/schemas.wp.org\/trunk\/theme.json",
  "version":2,
  "settings":{
    "appearanceTools":true,
    "color":{
      "palette":[
        {
          "slug":"primary",
          "color":"var(--primary-base)",
          "name":"Primary"
        },
        {
          "slug":"secondary",
          "color":"var(--secondary-base)",
          "name":"Secondary"
        },
        {
          "slug":"success",
          "color":"var(--success-base)",
          "name":"Success"
        },
        {
          "slug":"info",
          "color":"var(--info-base)",
          "name":"Info"
        },
        {
          "slug":"warning",
          "color":"var(--warning-base)",
          "name":"Warning"
        },
        {
          "slug":"danger",
          "color":"var(--danger-base)",
          "name":"Danger"
        },
        {
          "slug":"accent",
          "color":"var(--accent-base)",
          "name":"Accent"
        },
        {
          "slug":"inverse",
          "color":"var(--inverse-base)",
          "name":"Inverse"
        }
      ]
    },
    "spacing":[
      {
        "units":[
          "px",
          "em",
          "rem",
          "vh",
          "vw"
        ]
      }
    ],
    "layout":{
      "contentSize":"840px",
      "wideSize":"1100px"
    }
  },
  "styles": {
    "elements": {
      "button": {
        "border": {
          "color": "var(--primary-bg)",
          "style": "solid",
          "width": "var(--border-width)",
          "radius": "var(--btn-input-border-radius)"
        },
        "color": {
          "background": "var(--primary-bg)",
          "text": "var(--primary-contrast)"
        },
        "spacing": {
          "padding": {
            "top": "var(--btn-input-padding-y)",
            "right": "var(--btn-input-padding-x)",
            "bottom": "var(--btn-input-padding-y)",
            "left": "var(--btn-input-padding-x)"
          }
        },
        "typography": {
          "fontFamily": "inherit",
          "fontSize": "var(--btn-input-font-size)",
          "fontWeight": "var(--btn-input-font-weight)",
          "lineHeight": "var(--btn-input-line-height)"
        },
        ":focus": {
          "outline": {
            "color": "var(--focus-ring-color)",
            "offset": "var(--focus-ring-offset)",
            "style": "solid",
            "width": "var(--focus-ring-width)"
          }
        }
      },
      "link": {
        "color": {
          "text": "var(--link-color)"
        },
        ":hover": {
          "color": {
            "text": "var(--link-hover-color)"
          }
        }
      },
      "textInput": {
        "border": {
          "color": "var(--border-color)",
          "style": "solid",
          "width": "var(--border-width)",
          "radius": "var(--btn-input-border-radius)"
        },
        "color": {
          "background": "var(--btn-input-bg)",
          "text": "var(--btn-input-fg)"
        },
        "spacing": {
          "padding": {
            "top": "var(--btn-input-padding-y)",
            "right": "var(--btn-input-padding-x)",
            "bottom": "var(--btn-input-padding-y)",
            "left": "var(--btn-input-padding-x)"
          }
        },
        "typography": {
          "fontFamily": "inherit",
          "fontSize": "var(--btn-input-font-size)",
          "lineHeight": "var(--btn-input-line-height)"
        }
      },
      "select": {
        "border": {
          "color": "var(--border-color)",
          "style": "solid",
          "width": "var(--border-width)",
          "radius": "var(--btn-input-border-radius)"
        },
        "color": {
          "background": "var(--btn-input-bg)",
          "text": "var(--btn-input-fg)"
        },
        "spacing": {
          "padding": {
            "top": "var(--btn-input-padding-y)",
            "right": "var(--btn-input-padding-x)",
            "bottom": "var(--btn-input-padding-y)",
            "left": "var(--btn-input-padding-x)"
          }
        },
        "typography": {
          "fontFamily": "inherit",
          "fontSize": "var(--btn-input-font-size)",
          "lineHeight": "var(--btn-input-line-height)"
        }
      }
    }
  }
}
